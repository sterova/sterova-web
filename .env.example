# ───────────────────────────────────────────────
# Sterova Web — Environment Variables
# ───────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to Git.
# ───────────────────────────────────────────────

# ─── Client-side (safe to expose in browser) ──
# These are bundled into the frontend build.
# Protected by Supabase Row Level Security (RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Server-side only (NEVER expose these) ────
# These are used by server functions, migrations,
# and admin scripts only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ─── Database (server-side only) ──────────────
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=
DIRECT_URL=