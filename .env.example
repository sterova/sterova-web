# =============================================================================
# Sterova — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# Add all secrets via Replit Secrets (never commit real values).
# Sync production values to Vercel → Settings → Environment Variables.
# Only sync to "Production" unless explicitly required elsewhere.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Public keys are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose in the browser. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Resend — Email (optional, graceful fallback when missing)
# -----------------------------------------------------------------------------
# The app works without this key; contact form submissions are still saved to
# Supabase. Add the key when you're ready to enable email notifications.
RESEND_API_KEY=re_your-resend-api-key

# The address that receives contact form submissions.
CONTACT_EMAIL=hello@sterova.tech

# The "From" address used in outgoing emails (must be verified in Resend).
FROM_EMAIL=hello@sterova.tech

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://sterova.tech
