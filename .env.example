# Supabase Configuration
# Required for connecting the web app to Supabase (Database, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Database Connection String
# Required for backend/database scripts (seeding, migration)
POSTGRES_URL=postgresql://postgres:password@localhost:54322/postgres
POSTGRES_URL_NON_POOLING=postgresql://postgres:password@localhost:54322/postgres
