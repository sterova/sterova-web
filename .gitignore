# ───────────────────────────────────────────────
# Sterova Web — .gitignore
# ───────────────────────────────────────────────

# Dependencies
node_modules

# ─── Environment / Secrets ────────────────────
# Catch ALL .env variants (.env, .env.local, .env.production, .dev.vars, etc.)
.env*
!.env.example
.dev.vars

# ─── Build output ─────────────────────────────
dist
dist-ssr
.output
.vinxi
.nitro
*.local

# ─── TanStack ─────────────────────────────────
.tanstack/**
.tanstack

# ─── Wrangler / Cloudflare ────────────────────
.wrangler/

# ─── Vercel ───────────────────────────────────
.vercel

# ─── Logs ─────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Editor / IDE ─────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS files ─────────────────────────────────
.DS_Store
Thumbs.db

# ─── Turbo / Cache ────────────────────────────
.turbo
.others